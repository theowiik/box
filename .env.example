# Copy to .env (gitignored) and fill in what applies to this machine.
# A real environment variable always wins over this file.

# --- Connectors: where the box is -------------------------------------------
# The box announces itself as box.local over mDNS. If that does not resolve
# on your network, use its IP (it scrolls it across the panel at boot).
# BOX_URL=http://box.local
# Only if the firmware was built with CONFIG_BOX_TOKEN:
# BOX_TOKEN=

# --- box-sources (connectors/sources) ----------------------------------------
# BOX_CITY=Stockholm
# BOX_FEEDS=0                      # weather only
# BOX_STATE_DIR=~/.local/state/box # which feed items were already shown

# --- Building and installing the firmware ------------------------------------
# An esp-mosaico-vibe checkout (github.com/esp-mosaico/esp-mosaico-vibe),
# set up per its README. Needed only to build the firmware.
MOSAICO_WORKSPACE=/path/to/esp-mosaico-vibe
# A command prefix that runs things with ESP-IDF loaded, if your shell does
# not already have it (e.g. a NixOS FHS wrapper). Leave unset otherwise.
# MOSAICO_SHELL=/path/to/fhs-wrapper
