# Copy to .env (gitignored) and fill in what applies to this machine.
# A real environment variable always wins over this file.

# --- Connectors: where the box is -----------------------------------------
# The box announces itself as box.local over mDNS. If that does not resolve
# on your network, use its IP (it shows it on screen at boot).
# BOX_URL=http://box.local
# Only if the firmware was built with CONFIG_BOX_TOKEN:
# BOX_TOKEN=

# --- box-essentials (connectors/box-essentials) ---------------------------------
# The weather's place and the feeds are set on its page, not here.
# BOX_WEB_ADDR=:8090                # where that page listens
# BOX_STATE_DIR=~/.local/state/box  # the settings and feed history
